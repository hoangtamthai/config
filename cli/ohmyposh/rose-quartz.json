{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "foreground": "#e67d99",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "{{ .Path }}"
        },
        {
          "type": "root",
          "foreground": "#ffffff",
          "style": "plain",
          "template": " \uf0e7 "
        },
        {
          "type": "dart",
          "foreground": "#06A4CE",
          "style": "plain",
          "template": " \uE798 {{ .Full }} "
        },
        {
          "type": "java",
          "foreground": "#e67b90",
          "style": "plain",
          "template": " \ue738 {{ .Full }} "
        },
        {
          "type": "python",
          "foreground": "#26547a",
          "powerline_symbol": "py",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": true
          },
          "style": "plain",
          "template": " py {{ if .Venv }}({{ .Venv }}) {{ end }}{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}",
            "{{ if eq .Code 0 }}#e488b6{{ end }}"
          ],
          "background": "transparent",
          "template": "\n> "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#e488b6",
    "template": "> "
  }
}

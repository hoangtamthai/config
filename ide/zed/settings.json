{
  "agent": {
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "model": "gpt-6.1-sol",
      "provider": "openai-subscribed"
    },
    "default_profile": "write",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "thinking_display": "preview",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "create_directory": {
          "default": "allow"
        },
        "delete_path": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        }
      }
    }
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "agent_ui_font_size": 15.0,
  "auto_update": false,
  "buffer_font_family": "RobotoMono Nerd Font",
  "buffer_font_size": 15.0,
  "buffer_line_height": "comfortable",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false
  },
  "debugger": {
    "dock": "bottom",
    "format_dap_log_messages": false,
    "log_dap_communications": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "diff_view_style": "unified",
  "disable_ai": false,
  "enable_language_server": true,
  "experimental.theme_overrides": {
    "background": "#1a1117",
    "border": "#333333",
    "border.disabled": "#9498a1",
    "border.focused": "#fe7c8e",
    "border.selected": "#fe7c8e",

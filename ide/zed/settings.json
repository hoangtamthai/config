    "element.disabled": "#241118",
    "element.hover": "#45222e",
    "element.selected": "#45222e",
    "element.selection_background": "#45222e",
    "elevated_surface.background": "#241118",
    "error": "#ff62a5",
    "error.background": "#472541",
    "error.border": "#ff4791",
    "ghost_element.active": "#884444",
    "ghost_element.background": "#00000000",
    "ghost_element.disabled": "#241118",
    "ghost_element.hover": "#642130",
    "ghost_element.selected": "#884444",
    "hidden": "#6D7A72",

    "text.disabled": "#6D7A72",
    "text.muted": "#dedededd",
    "text.placeholder": "#6D7A72",
    "title_bar.background": "#241118",
    "title_bar.inactive_background": "#241118",
    "toolbar.background": "#241118"
  },
  "file_scan_exclusions": ["**/node_modules"],
  "file_scan_inclusions": ["**/.git"],
  "formatter": [
    {
      "external": {
        "arguments": ["-e", "s/ *$//"],
        "command": "sed"
      }
    }
  ],
  "git": {
    "diff_base": "head",
    "file_diff": {
      "show_full_file": true
    },
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "delay_ms": 0,
      "enabled": true,
      "location": "inline",
      "min_column": 0,
      "padding": 7,
      "show_commit_summary": true
    },
    "show_stage_restore_buttons": true
  },
  "git_panel": {
    "collapse_untracked_diff": false,
    "diff_stats": true,
    "dock": "left",
    "group_by": "staging",
    "tree_view": true
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        "font_style": "normal",
        "foreground_color": "#cd87ed",
        "token_modifiers": ["constant"],
        "token_type": "variable"
      },
      {
        "font_style": "normal",
        "foreground_color": "#db6698",
        "token_modifiers": ["defaultLibrary"],
        "token_type": "variable"
      },
      {
        "font_style": "normal",
        "foreground_color": "#db6698",
        "token_modifiers": ["builtin"]
      },
      {
        "font_style": "normal",
        "foreground_color": "#d5d363",
        "token_type": "comment"
      },
      {
        "font_style": "normal",
        "foreground_color": "#9ecba3",
        "token_type": "function"
      },
      {
        "font_style": "normal",
        "foreground_color": "#9ecba3",
        "token_type": "method"
      },
      {
        "font_style": "normal",
        "foreground_color": "#9ecba3",
        "token_type": "macro"
      },
      {
        "font_style": "normal",
        "foreground_color": "#9ecba3",
        "token_type": "decorator"
      },
      {
        "font_style": "normal",
        "foreground_color": "#9ecba3",
        "token_type": "builtinAttribute"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "class"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "struct"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "enum"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "enumMember"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "interface"
      },
      {
        "font_style": "normal",
        "foreground_color": "#c6d0f5",
        "token_type": "derive"
      },
      {
        "font_style": "normal",
        "foreground_color": "#cd87ed",
        "token_type": "type"
      },
      {
        "font_style": "normal",
        "foreground_color": "#e2c5d2",
        "token_type": "parameter"
      },
      {
        "font_style": "normal",
        "foreground_color": "#e2c5d2",
        "token_type": "namespace"
      },
      {
        "font_style": "normal",
        "foreground_color": "#e2c5d2",
        "token_type": "variable"
      },
      {
        "font_style": "normal",
        "foreground_color": "#db6698",
        "token_type": "keyword"
      },
      {
        "font_style": "normal",
        "foreground_color": "#db6698",
        "token_type": "selfParameter"
      }
    ]
  },
  "gutter": {
    "folds": false,
    "git_gutter_width": "default"
  },
  "hard_tabs": false,
  "helix_mode": false,
  "icon_theme": "Colored Zed Icons Theme Dark",
  "language_models": {
    "openai_compatible": {}
  },
  "languages": {
    "JSON": {
      "formatter": [
        {
          "language_server": {
            "name": "json-language-server"
          }
        }
      ]
    },
    "JSONC": {
      "formatter": [
        {
          "language_server": {
            "name": "json-language-server"
          }
        }
      ]
    },
    "Python": {
      "formatter": [
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ],
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "ty",
        // "basedpyright",
        "ruff"
        // "pylsp",
        // "pyright"
      ]
    },
    "Rust": {
      "formatter": [
        {
          "language_server": {
            "name": "rust-analyzer"
          }
        }
      ]
    }
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "diagnosticMode": "workspace",
            "inlayHints": {
              "callArgumentNames": false
            }
          }
        }
      }
    },
    "pylsp": {
      "settings": {}
    },
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all"
        }
      }
    },
    "ty": {
      "settings": {}
    }
  },
  "lsp_results_location": "picker",
  "minimap": {
    "display_in": "active_editor",
    "max_width_columns": 80,
    "current_line_highlight": "line",
    "thumb_border": "none",
    "show": "always",
    "thumb": "always"
  },
  "outline_panel": {
    "dock": "right",
    "indent_size": 10.0
  },
  "preferred_line_length": 120,
  "prettier": {
    "allowed": true
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 10.0
  },
  "search": {
    "center_on_match": true
  },
  "semantic_tokens": "off",
  "session": {
    "trust_all_worktrees": true
  },
  "show_completions_on_input": true,
  "show_edit_predictions": true,
  "show_whitespaces": "boundary",
  "show_wrap_guides": true,
  "soft_wrap": "bounded",
  "soft_wrap_indent": "extra_one",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "activate_script": "default",
        "directories": [".env", "env", ".venv", "venv"]
      }
    },
    "dock": "right",
    "env": {
      "FORCE_COLOR": "3",
      "CLICOLOR_FORCE": "1",
      "BACKEND_PORT": "8888",
      "FRONTEND_PORT": "3333"
    },
    "font_size": 12.0
  },
  "windows": {
    "terminal": {
      "shell": {
        "with_arguments": {
          "args": ["-nop"],
          "program": "pwsh"
        }
      }
    }
  },
  "linux": {
    "terminal": {
      "shell": {
        "program": "/bin/zsh"
      }
    }
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "system"
  },
  "ui_font_family": "RobotoMono Nerd Font",
  "ui_font_size": 15.0,
  "use_system_path_prompts": true,
  "vertical_scroll_margin": 10.0,
  "vim_mode": true,
  "wrap_guides": [120]
}
